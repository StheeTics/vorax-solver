{
  "name": "vorax-overlay",
  "productName": "Vorax Overlay",
  "version": "0.1.14",
  "description": "The Vorax Solver as a Windows app, with its advice in an overlay over the game.",
  "author": "tidewarden",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "local": "electron . --site=http://localhost:5173/tli-vorax-simulator/",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "koffi": "2.16.3"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "io.github.tidewarden.vorax-overlay",
    "productName": "Vorax Overlay",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "build/icon.png",
      "!node_modules/koffi/build/koffi/{darwin_arm64,darwin_x64,freebsd_arm64,freebsd_ia32,freebsd_x64,linux_arm64,linux_armhf,linux_ia32,linux_loong64,linux_riscv64d,linux_x64,musl_arm64,musl_x64,openbsd_ia32,openbsd_x64,win32_arm64,win32_ia32}/**",
      "!node_modules/koffi/{src,vendor,doc}/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Vorax-Overlay-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tidewarden",
        "repo": "tli-vorax-simulator",
        "releaseType": "release"
      }
    ]
  }
}
